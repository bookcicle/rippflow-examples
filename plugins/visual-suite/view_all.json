{
  "$schema": "https://rippflow.com/schemas/declarative-ui.v1.json",
  "id": "visual-suite-all",
  "title": "Universal Visual Showcase",
  "icon": "bar-chart-2",
  "layout": {
    "type": "Container",
    "gap": 16,
    "padding": 16,
    "children": [
      {
        "type": "Row",
        "gap": 12,
        "children": [
          {
            "type": "MetricCard",
            "label": "P99 Batch Latency",
            "value": "42.8 ms",
            "trend": "-6.4%",
            "status": "success"
          },
          {
            "type": "MetricCard",
            "label": "Active Swarm Nodes",
            "value": "8 Agents",
            "trend": "+2 nodes",
            "status": "info"
          },
          {
            "type": "MetricCard",
            "label": "GPU VRAM In Use",
            "value": "22.2 / 24 GB",
            "trend": "+8.2%",
            "status": "warning"
          },
          {
            "type": "MetricCard",
            "label": "Global Regions",
            "value": "4 Clusters",
            "trend": "100% Up",
            "status": "success"
          }
        ]
      },
      {
        "type": "Row",
        "gap": 12,
        "children": [
          {
            "type": "CandleStick",
            "title": "Execution Latency Variance (OHLC)",
            "source": { "file": "latency_stream.jsonl" }
          },
          {
            "type": "Histogram",
            "title": "Token Length Distribution",
            "bins": 14,
            "source": { "file": "histogram_stream.jsonl" }
          }
        ]
      },
      {
        "type": "Row",
        "gap": 12,
        "children": [
          {
            "type": "ReactiveGraph",
            "title": "Reactive Swarm Mesh",
            "source": { "file": "swarm_mesh.json" }
          },
          {
            "type": "RadialTree",
            "title": "Concentric Radial Hierarchy",
            "source": { "file": "radial_tree.json" }
          }
        ]
      },
      {
        "type": "Row",
        "gap": 12,
        "children": [
          {
            "type": "BubbleChart",
            "title": "Model Benchmark Frontier",
            "source": { "file": "bubble_models.json" }
          },
          {
            "type": "ParallelSets",
            "title": "Hyperparameter Sweep",
            "dimensions": [
              "Learning Rate",
              "Batch Size",
              "Optimizer",
              "Val Loss"
            ],
            "source": { "file": "parallel_runs.json" }
          }
        ]
      },
      {
        "type": "Row",
        "gap": 12,
        "children": [
          {
            "type": "GeoMap",
            "title": "Global Multi-Region Mesh",
            "source": { "file": "geo_clusters.json" }
          },
          {
            "type": "GeoMap",
            "title": "US Continental State Topology",
            "scope": "usa",
            "granularity": "state",
            "source": { "file": "us_states_geo.json" }
          }
        ]
      },
      {
        "type": "Row",
        "gap": 12,
        "children": [
          {
            "type": "GeoMap",
            "title": "California State Grid (State Focus)",
            "scope": "CA",
            "granularity": "state"
          },
          {
            "type": "GeoMap",
            "title": "Japan Edge Topology (Country Focus)",
            "scope": "JP",
            "granularity": "country"
          }
        ]
      },
      {
        "type": "Row",
        "gap": 12,
        "children": [
          {
            "type": "DonutChart",
            "title": "GPU VRAM Allocation",
            "source": { "file": "vram_donut.json" }
          },
          {
            "type": "Contour",
            "title": "2D Loss Landscape Surface",
            "source": { "file": "contour_matrix.json" }
          }
        ]
      },
      {
        "type": "Row",
        "gap": 12,
        "children": [
          {
            "type": "Sunburst",
            "title": "Compute Hierarchy Partition",
            "source": { "file": "sunburst.json" }
          },
          {
            "type": "HorizontalBar",
            "title": "Model Throughput Benchmarks",
            "source": { "file": "horizontal_bar.json" }
          }
        ]
      },
      {
        "type": "Row",
        "gap": 12,
        "children": [
          {
            "type": "RaceChart",
            "title": "Live Agent Token Race",
            "source": { "file": "race_chart.json" }
          },
          {
            "type": "Table",
            "title": "Active Swarm Agent Workers",
            "source": { "file": "swarm_workers.json" },
            "columns": ["Agent", "Role", "Status", "Load", "Tokens/s"],
            "rows": [
              ["coordinator-1", "Orchestrator", "Active", "84%", "142"],
              ["researcher-1", "Context Ingestion", "Active", "62%", "310"],
              ["coder-1", "Rust/C++ Author", "Active", "95%", "280"],
              ["verifier-1", "QA & Test Runner", "Active", "48%", "190"]
            ]
          }
        ]
      }
    ]
  }
}
