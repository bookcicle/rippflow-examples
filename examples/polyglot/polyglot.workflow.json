{
  "name": "mixed-polyglot-pipeline",
  "version": "2.0.0",
  "default_group": "python-standard",
  "phases": {
    "ingest-packet": {
      "requires": [],
      "service": "simulated.splitter",
      "scope": "root",
      "inputs": {
        "simulated": true
      },
      "group": "rust-light"
    },
    "parse-statement": {
      "requires": [
        "ingest-packet"
      ],
      "service": "simulated.ocr_extract",
      "scope": "per_shard",
      "inputs": {
        "dpi": 300,
        "simulated": true
      },
      "group": "python-standard"
    },
    "verify-balance": {
      "requires": [
        "parse-statement"
      ],
      "service": "simulated.balance_auditor",
      "scope": "per_shard",
      "outcomes": {
        "completed": {
          "advance_barrier": true
        },
        "rework": {
          "rerun_phase": "parse-statement",
          "max_loops": 2,
          "override_inputs": {
            "dpi": 600,
            "high_accuracy_table_mode": true
          }
        }
      },
      "group": "node-standard"
    },
    "emit-underwriting-summary": {
      "requires": [
        "verify-balance"
      ],
      "service": "simulated.underwriter_summary",
      "scope": "fan_in_all",
      "terminal": true,
      "group": "java-standard"
    }
  }
}
