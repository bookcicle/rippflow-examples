# Copy to `.env` (gitignored) for local defaults.
# Note: in `cloud` mode (`rippflow run --rippflow-env cloud` or AWS Lambda),
# Codex/Gemini CLIs & SDKs are automatically disabled (`AI_CHANGELOG_DEFAULT=disabled`),
# requiring ZERO local AI dependencies!

WORKSPACE_DIR=/path/to/your/git-workspace
RELEASE_VERSION=0.2.0

# Optional webhook endpoints for `release_signoff_gate` (used in both local & cloud):
SLACK_WEBHOOK_URL=
EMAIL_WEBHOOK_URL=

# Optional local-only AI model overrides (ignored when RIPPFLOW_ENV=cloud):
ENABLE_AI_CHANGELOG=auto
CHANGELOG_PROVIDER=auto
GEMINI_MODEL=gemini-3.8-flash
CODEX_MODEL=gpt-6.1-sol
