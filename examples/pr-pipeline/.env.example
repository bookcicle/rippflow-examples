# Copy this file to `.env` (gitignored) so your workspace path, GitHub accounts,
# and model preferences are picked up automatically without repeating them in
# every workflow request JSON payload.

WORKSPACE_DIR=/path/to/your/git-workspace
AUTHOR_GH_USER=your-author-bot-account
AUTHOR_GIT_EMAIL=your-author-bot-account@users.noreply.github.com
REVIEWER_GH_USER=your-reviewer-account

AUTHOR_MODEL=gemini-3.8-flash
REVIEWER_MODEL=gpt-6.1-sol
MAX_TURNS=15
BRANCH_PREFIX=ai/feature
ENABLE_OS_NOTIFICATIONS=true
