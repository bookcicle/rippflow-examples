# Copy to `.env` (gitignored) to configure your local workspace, PR bot identity, and notifications.
# Never commit personal paths, usernames, or webhook URLs.

WORKSPACE_DIR=

# Execution mode:
# - "dry_run" (default): reports stale worktrees, Cargo target/ sizes, & Docker prune estimates safely
#   without deleting host directories or pushing remote PRs; upgrades run in isolated `.runs/<id>/worktrees/`.
# - "live": executes real `git worktree prune`, deletes configured `target/` dirs, runs `docker image prune -f`,
#   and pushes green upgrade branches / opens GitHub PRs via `gh pr create`.
NIGHTWATCH_EXECUTION_MODE=dry_run

# Disk & Container Hygiene Controls
CLEAN_STALE_WORKTREES=true
STALE_WORKTREE_HOURS=24
DELETE_CARGO_TARGETS=true
CLEAN_DOCKER_IMAGES=true
DOCKER_PRUNE_UNTIL=72h

# AI Upgrader Controls (automatically flagged OFF when `RIPPFLOW_ENV=cloud`!)
ENABLE_AI_UPGRADER=auto
UPGRADER_PROVIDER=auto
GEMINI_MODEL=gemini-4-hydrogen-medium
CODEX_MODEL=gpt-6.1-sol

# Optional GitHub Bot Identity for opening overnight PRs (`executionMode=live`)
NIGHTWATCH_GH_USER=
NIGHTWATCH_GIT_EMAIL=
BRANCH_PREFIX=nightwatch/deps

# Morning Digest Webhooks (optional; native OS notification fires automatically in `local` mode)
SLACK_WEBHOOK_URL=
EMAIL_WEBHOOK_URL=
